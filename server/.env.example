# Copy to server/.env. Every value is optional in development.

# Used by `npm start`. `npm run dev` always uses 5000, which Vite's proxy expects.
PORT=5000

# Leave empty to run the embedded MongoDB (data kept in ~/.fitness-consistency/data).
# Local install:  mongodb://127.0.0.1:27017/fitness_consistency
# Atlas:          mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/fitness_consistency
MONGO_URI=

# Required when NODE_ENV=production. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:5173
ENABLE_DEMO=true
